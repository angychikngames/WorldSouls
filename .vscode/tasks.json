{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build World Souls",
            "type": "process",
            "command": "bash",
            "windows": {
                "command": "${workspaceFolder}\\gradlew.bat",
                "args": [
                    "build",
                    "--console=plain"
                ]
            },
            "args": [
                "${workspaceFolder}/gradlew",
                "build",
                "--console=plain"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run Minecraft client",
            "type": "process",
            "command": "bash",
            "windows": {
                "command": "${workspaceFolder}\\gradlew.bat",
                "args": [
                    "runClient",
                    "--console=plain"
                ]
            },
            "args": [
                "${workspaceFolder}/gradlew",
                "runClient",
                "--console=plain"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "prepareRunClientCompile",
            "type": "process",
            "command": "bash",
            "windows": {
                "command": "${workspaceFolder}\\gradlew.bat",
                "args": [
                    "prepareRunClientCompile",
                    "--console=plain"
                ]
            },
            "args": [
                "${workspaceFolder}/gradlew",
                "prepareRunClientCompile",
                "--console=plain"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
